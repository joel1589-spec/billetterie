# Neon : copier la chaîne de connexion (idéalement la DIRECTE, sans "-pooler")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=change-me
DEBUG=1
REDIS_URL=redis://localhost:6379/0
WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_URL=http://localhost:8000/api/payments/webhook/
# Rate limiting (augmenter pour le script de charge)
RESERVATION_RATE=20/min
AUTH_RATE=10/min
